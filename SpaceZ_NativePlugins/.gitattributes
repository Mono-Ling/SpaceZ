# ===========================================================================
#  SpaceZ_NativePlugins —— 原生插件自己的 git 属性
#  就近生效：本目录下的文件优先用这里的规则（全局 * text=auto 仍然兜底）
# ===========================================================================

* text=auto

# Windows 批处理必须是 CRLF，否则 cmd 解析 goto/label 可能出错
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制产物不做换行转换、不做行级 diff
*.dll binary
*.lib binary
*.exe binary
*.pdb binary
*.exp binary
